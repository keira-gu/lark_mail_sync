# ============================================================
#  邮件同步工具配置（把本文件复制为 .env 后填写）
#  ⚠ 填好的 .env 等于钥匙：不截图、不转发、不提交到任何地方
# ============================================================

# ===== 你自己申请的企业自建应用（见 references/应用申请指引.md） =====
# 同一个应用既读邮件又写多维表：开 mail:user_mailbox.message:readonly
# 和 bitable:app 两个权限并发布通过后，把凭证抄到这里
# App ID 即 cli_ 开头那串；App Secret 只显示一次，没抄到就重置
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_URL=https://open.larksuite.com

# ===== 你的邮箱 =====
# 填你自己的邮箱地址（如 you@yourcompany.com）
# 注意：应用的「可用范围」要包含你自己，否则自检报 99991672
MAIL_USER_MAILBOX_ID=
MAIL_FOLDER_ID=INBOX

# ===== 目标多维表（管理员发的表信息，不是机密） =====
# 管理员也可能只发一条表链接：/base/ 后面那串=APP_TOKEN，table= 后面 tbl 开头=TABLE_ID
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
# 以下两行留空 = 复用上面同一个应用写表（正常都留空）
BITABLE_APP_ID=
BITABLE_APP_SECRET=

# ===== GoFreight 建立应付（可选；不用建立应付整段留空即可） =====
# 五样都由管理员另外发给你（这是机密，同样不要截图/转发）
GOFREIGHT_BASE_URL=
GOFREIGHT_USER=
GOFREIGHT_PASSWORD=
# 费用代码：管理员发的口径值，逐字照抄
GOFREIGHT_FEE_CODE=
# 供应商映射 JSON：表内「服务商名称」→ {"search": 无空格短词, "code": 编号}
# 没配映射的服务商只会出现在 plan 清单里并注明原因，绝不提交
GOFREIGHT_VENDOR_MAP={"ABC Logistics": {"search": "ABC", "code": "VN-000001"}}
# 以下一般不用改
GOFREIGHT_STATE_PATH=data/gofreight_state.json
GOFREIGHT_SHOT_DIR=runtime-outputs/gofreight
GOFREIGHT_BROWSER_STATE=runtime-outputs/gofreight/state.json

# ===== 以下一般不用改（默认即正确口径） =====
CONFIRM_KEYWORD=confirm
ARCHIVE_FOLDER_ID=ARCHIVED
FIELD_DATE=收到邮件日期
FIELD_SUBJECT=邮件主题
FIELD_RECIPIENT=收件人邮箱号
FIELD_TK=TK号
FIELD_QTY=数量
FIELD_ALLOC_AMOUNT=摊分金额
FIELD_INVOICE_AMOUNT=发票金额
FIELD_VENDOR=服务商名称
FIELD_OUR_COMPANY=我司名称
FIELD_CURRENCY=发票币种
FIELD_INVOICE_DATE=开票日期
FIELD_INVOICE_DUE=发票DUE date
FIELD_INVOICE_NAME=发票名称
FIELD_INVOICE_NO=发票号
FIELD_INVOICE_FILE=发票
FIELD_ERROR=异常报错
FIELD_FEE_ITEM=费用项-结算手动提供
FIELD_MSG_ID=消息ID
ATTACHMENT_MAX_MB=30
SYNC_INTERVAL_SECONDS=300
SCAN_STOP_AFTER_SEEN=100
STATE_PATH=data/state.json
REQUEST_TIMEOUT=30
